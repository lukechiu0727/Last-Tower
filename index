      if (e.target.closest('button') || e.target.closest('#upgradeModal') || e.target.closest('#startModal') || e.target.closest('#gameOverModal') || e.target.closest('#pauseModal')) return;
      pointer.isDown = true;
      handlePointer(e.clientX, e.clientY);
    });

    window.addEventListener('mouseup', () => {
      pointer.isDown = false;
      citadel.isManualAiming = false;
    });

    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      if (e.touches.length > 0) {
        pointer.isDown = true;
        handlePointer(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: false });

