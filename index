    function handlePointer(clientX, clientY) {
      pointer.x = clientX;
      pointer.y = clientY;
      const dx = clientX - centerX;
      const dy = clientY - centerY;
      citadel.angle = Math.atan2(dy, dx);
      citadel.isManualAiming = true;
    }

    window.addEventListener('mousemove', (e) => {
      if (pointer.isDown) handlePointer(e.clientX, e.clientY);
    });

