        });
      }
    }

    function updateAutoAim() {
      if (!citadel.autoAim || citadel.isManualAiming) return;
      if (enemies.length === 0) return;

      let bestTarget = null;
      let closestDist = Infinity;

      for (let en of enemies) {
        if (en.isBoss) {
          bestTarget = en;
          break;
        }
        const d = Math.hypot(en.x - centerX, en.y - centerY);
        if (d < closestDist) {
          closestDist = d;
          bestTarget = en;
        }
      }

      if (bestTarget) {
        const targetAngle = Math.atan2(bestTarget.y - centerY, bestTarget.x - centerX);
        let diff = targetAngle - citadel.angle;
        while (diff < -Math.PI) diff += Math.PI * 2;
        while (diff > Math.PI) diff -= Math.PI * 2;
        citadel.angle += diff * 0.28;
      }
    }

